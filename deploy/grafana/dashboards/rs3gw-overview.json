{
  "dashboard": {
    "title": "rs3gw Overview",
    "tags": ["rs3gw", "s3", "storage"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "title": "Request Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(rs3gw_requests_total[5m])",
            "legendFormat": "{{operation}} - {{status}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 2,
        "title": "Request Latency (p95)",
        "type": "graph",
        "gridPos": {"x": 12, "y": 0, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(rs3gw_request_duration_seconds_bucket[5m]))",
            "legendFormat": "{{operation}} p95",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "title": "Storage Usage",
        "type": "graph",
        "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rs3gw_storage_total_bytes",
            "legendFormat": "Total Storage",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "title": "Object Count",
        "type": "graph",
        "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rs3gw_storage_object_count",
            "legendFormat": "Objects",
            "refId": "A"
          }
        ]
      },
      {
        "id": 5,
        "title": "Cache Hit Rate",
        "type": "graph",
        "gridPos": {"x": 0, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(rs3gw_cache_hits_total[5m]) / (rate(rs3gw_cache_hits_total[5m]) + rate(rs3gw_cache_misses_total[5m]))",
            "legendFormat": "Hit Rate",
            "refId": "A"
          }
        ]
      },
      {
        "id": 6,
        "title": "Error Rate",
        "type": "graph",
        "gridPos": {"x": 12, "y": 16, "w": 12, "h": 8},
        "targets": [
          {
            "expr": "rate(rs3gw_requests_total{status!~\"2..\"}[5m])",
            "legendFormat": "{{operation}} - {{status}}",
            "refId": "A"
          }
        ]
      }
    ]
  }
}
