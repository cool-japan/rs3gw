{
  "id": "imagenet-preprocessing",
  "name": "ImageNet Preprocessing",
  "version": "1.0.0",
  "description": "Standard ImageNet preprocessing pipeline for image classification",
  "steps": [
    {
      "id": "resize",
      "step_type": "image_resize",
      "config": {
        "width": 224,
        "height": 224,
        "mode": "fit",
        "filter": "lanczos3"
      },
      "cache_results": false,
      "description": "Resize to 224x224 for ImageNet models"
    },
    {
      "id": "normalize",
      "step_type": "image_normalization",
      "config": {
        "mean": [0.485, 0.456, 0.406],
        "std": [0.229, 0.224, 0.225],
        "normalize_range": true
      },
      "cache_results": true,
      "description": "Apply ImageNet normalization (mean and std per channel)"
    }
  ],
  "metadata": {
    "created_at": "2025-12-31T00:00:00Z",
    "author": "ml-engineer",
    "target_model": "ResNet/VGG/Inception",
    "dataset": "ImageNet ILSVRC"
  }
}
